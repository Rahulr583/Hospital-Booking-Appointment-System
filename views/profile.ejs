<%- include('partials/header') %>

<div class="profile-page container">
  <div class="profile-header">
    <div class="profile-avatar-large"><%= user.name.charAt(0).toUpperCase() %></div>
    <div class="profile-header-info">
      <h1><%= user.name %></h1>
      <span class="role-badge-lg role-<%= user.role %>"><%= user.role %></span>
      <p><%= user.email %></p>
    </div>
  </div>

  <% if (error && error.length > 0) { %>
    <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error[0] %></div>
  <% } %>
  <% if (success && success.length > 0) { %>
    <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success[0] %></div>
  <% } %>

  <div class="profile-grid">
    <div class="profile-form-card">
      <h3><i class="fas fa-user-edit"></i> Edit Profile</h3>
      <form action="/profile" method="POST" class="profile-form">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Full Name</label>
            <input type="text" name="name" class="form-input" value="<%= profile.name %>" required>
          </div>
          <div class="form-group">
            <label class="form-label">Phone Number</label>
            <input type="tel" name="phone" class="form-input" value="<%= profile.phone || '' %>">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Date of Birth</label>
            <input type="date" name="date_of_birth" class="form-input" value="<%= profile.date_of_birth || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">Gender</label>
            <select name="gender" class="form-input">
              <option value="">Select</option>
              <option value="Male" <%= profile.gender === 'Male' ? 'selected' : '' %>>Male</option>
              <option value="Female" <%= profile.gender === 'Female' ? 'selected' : '' %>>Female</option>
              <option value="Other" <%= profile.gender === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Address</label>
          <textarea name="address" class="form-input form-textarea" rows="3"><%= profile.address || '' %></textarea>
        </div>
        <button type="submit" class="btn-auth-submit">Save Changes</button>
      </form>
    </div>

    <div class="profile-info-card">
      <div class="profile-info-item">
        <i class="fas fa-envelope"></i>
        <div>
          <span class="info-label">Email</span>
          <span class="info-value"><%= profile.email %></span>
        </div>
      </div>
      <div class="profile-info-item">
        <i class="fas fa-phone"></i>
        <div>
          <span class="info-label">Phone</span>
          <span class="info-value"><%= profile.phone || 'Not provided' %></span>
        </div>
      </div>
      <div class="profile-info-item">
        <i class="fas fa-calendar"></i>
        <div>
          <span class="info-label">Date of Birth</span>
          <span class="info-value"><%= profile.date_of_birth || 'Not provided' %></span>
        </div>
      </div>
      <div class="profile-info-item">
        <i class="fas fa-venus-mars"></i>
        <div>
          <span class="info-label">Gender</span>
          <span class="info-value"><%= profile.gender || 'Not provided' %></span>
        </div>
      </div>
      <div class="profile-info-item">
        <i class="fas fa-map-marker-alt"></i>
        <div>
          <span class="info-label">Address</span>
          <span class="info-value"><%= profile.address || 'Not provided' %></span>
        </div>
      </div>
      <div class="profile-info-item">
        <i class="fas fa-calendar-plus"></i>
        <div>
          <span class="info-label">Member Since</span>
          <span class="info-value"><%= profile.created_at %></span>
        </div>
      </div>
      <div class="profile-quick-actions">
        <a href="/appointments" class="pqa-btn"><i class="fas fa-calendar"></i> My Appointments</a>
        <% if (user.role === 'patient') { %>
          <a href="/appointments/book" class="pqa-btn pqa-primary"><i class="fas fa-plus"></i> Book Appointment</a>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
