<%- include('../partials/header') %>

<div class="appt-detail-page container">
  <a href="/appointments" class="back-link"><i class="fas fa-arrow-left"></i> Back to Appointments</a>

  <% if (error && error.length > 0) { %>
    <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error[0] %></div>
  <% } %>
  <% if (success && success.length > 0) { %>
    <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success[0] %></div>
  <% } %>

  <div class="appt-detail-grid">
    <div class="appt-detail-main">
      <div class="detail-card">
        <div class="detail-card-header">
          <h2>Appointment #<%= appointment.id %></h2>
          <span class="status-badge status-<%= appointment.status %> status-lg"><%= appointment.status %></span>
        </div>

        <div class="detail-section">
          <h3><i class="fas fa-user-md"></i> Doctor Information</h3>
          <div class="detail-info-grid">
            <div class="detail-info-item">
              <span class="dii-label">Doctor Name</span>
              <span class="dii-value"><%= appointment.doctor_name %></span>
            </div>
            <div class="detail-info-item">
              <span class="dii-label">Specialization</span>
              <span class="dii-value"><%= appointment.specialization %></span>
            </div>
            <div class="detail-info-item">
              <span class="dii-label">Department</span>
              <span class="dii-value"><%= appointment.department %></span>
            </div>
            <div class="detail-info-item">
              <span class="dii-label">Consultation Fee</span>
              <span class="dii-value">₹<%= appointment.consultation_fee %></span>
            </div>
          </div>
        </div>

        <div class="detail-section">
          <h3><i class="fas fa-user"></i> Patient Information</h3>
          <div class="detail-info-grid">
            <div class="detail-info-item">
              <span class="dii-label">Patient Name</span>
              <span class="dii-value"><%= appointment.patient_name %></span>
            </div>
            <div class="detail-info-item">
              <span class="dii-label">Email</span>
              <span class="dii-value"><%= appointment.patient_email %></span>
            </div>
            <div class="detail-info-item">
              <span class="dii-label">Phone</span>
              <span class="dii-value"><%= appointment.patient_phone || 'N/A' %></span>
            </div>
            <div class="detail-info-item">
              <span class="dii-label">Gender</span>
              <span class="dii-value"><%= appointment.gender || 'N/A' %></span>
            </div>
          </div>
        </div>

        <div class="detail-section">
          <h3><i class="fas fa-calendar-alt"></i> Appointment Details</h3>
          <div class="detail-info-grid">
            <div class="detail-info-item">
              <span class="dii-label">Date</span>
              <span class="dii-value"><%= appointment.appointment_date %></span>
            </div>
            <div class="detail-info-item">
              <span class="dii-label">Time</span>
              <span class="dii-value"><%= appointment.appointment_time %></span>
            </div>
            <div class="detail-info-item">
              <span class="dii-label">Booked On</span>
              <span class="dii-value"><%= appointment.created_at %></span>
            </div>
          </div>
        </div>

        <% if (appointment.reason) { %>
        <div class="detail-section">
          <h3><i class="fas fa-notes-medical"></i> Reason for Visit</h3>
          <p class="detail-text"><%= appointment.reason %></p>
        </div>
        <% } %>

        <% if (appointment.notes) { %>
        <div class="detail-section">
          <h3><i class="fas fa-clipboard"></i> Doctor's Notes</h3>
          <p class="detail-text"><%= appointment.notes %></p>
        </div>
        <% } %>

        <% if (appointment.prescription) { %>
        <div class="detail-section">
          <h3><i class="fas fa-prescription-bottle-alt"></i> Prescription</h3>
          <p class="detail-text prescription-text"><%= appointment.prescription %></p>
        </div>
        <% } %>
      </div>
    </div>

    <div class="appt-detail-side">
      <% if (user.role !== 'patient') { %>
      <div class="detail-card action-card">
        <h3><i class="fas fa-edit"></i> Update Appointment</h3>
        <form action="/appointments/<%= appointment.id %>/status" method="POST">
          <div class="form-group">
            <label class="form-label">Status</label>
            <select name="status" class="form-input">
              <option value="pending" <%= appointment.status === 'pending' ? 'selected' : '' %>>Pending</option>
              <option value="confirmed" <%= appointment.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
              <option value="completed" <%= appointment.status === 'completed' ? 'selected' : '' %>>Completed</option>
              <option value="cancelled" <%= appointment.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Doctor's Notes</label>
            <textarea name="notes" class="form-input form-textarea" rows="3"><%= appointment.notes || '' %></textarea>
          </div>
          <div class="form-group">
            <label class="form-label">Prescription</label>
            <textarea name="prescription" class="form-input form-textarea" rows="4"><%= appointment.prescription || '' %></textarea>
          </div>
          <button type="submit" class="btn-update-appt">Update Appointment</button>
        </form>
      </div>
      <% } %>

      <% if (user.role === 'patient' && appointment.status === 'pending') { %>
      <div class="detail-card action-card">
        <h3>Appointment Actions</h3>
        <p>You can cancel this appointment if needed.</p>
        <form action="/appointments/<%= appointment.id %>/status" method="POST" onsubmit="return confirm('Are you sure you want to cancel this appointment?')">
          <input type="hidden" name="status" value="cancelled">
          <button type="submit" class="btn-cancel-appt">Cancel Appointment</button>
        </form>
      </div>
      <% } %>

      <div class="detail-card status-timeline">
        <h3>Status Timeline</h3>
        <div class="timeline">
          <div class="tl-item tl-done"><div class="tl-dot"></div><div class="tl-content"><span>Booked</span></div></div>
          <div class="tl-item <%= ['confirmed','completed'].includes(appointment.status) ? 'tl-done' : appointment.status === 'cancelled' ? 'tl-cancelled' : '' %>">
            <div class="tl-dot"></div><div class="tl-content"><span>Confirmed</span></div>
          </div>
          <div class="tl-item <%= appointment.status === 'completed' ? 'tl-done' : '' %>">
            <div class="tl-dot"></div><div class="tl-content"><span>Completed</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
